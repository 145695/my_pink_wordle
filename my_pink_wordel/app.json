{
  "expo": {
    "name": "my wordle",
    "slug": "my-pink-wordle",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/main_app_logo.png",
    "scheme": "mypinkwordel",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/main_app_logo.png",
      "bundleIdentifier": "com.yourname.mypinkwordle"
    },
    "android": {
      "package": "com.yourname.mypinkwordle",
      "adaptiveIcon": {
        "backgroundColor": "#f9dcee",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "736f0776-3882-441a-abf0-ce57cad48fbd"
      }
    }
  }
}